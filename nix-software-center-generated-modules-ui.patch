+/// Marker used to persist the editor state inside the generated Nix file.
+/// Keeping state and generated configuration together prevents a user-level
+/// sidecar database from drifting away from the system configuration.
+pub const MANAGED_STATE_PREFIX: &str = "# nix-software-center-state-json: ";
+
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", content = "value", rename_all = "snake_case")]
+pub enum ManagedValue {
+    Null,
+    Bool(bool),
+    Integer(i64),
+    Float(f64),
+    String(String),
+    Choice(String),
+    Path(String),
+    Package(String),
+    Json(Value),
+}
+
+#[derive(Debug, Clone, Default, PartialEq, Serialize, Deserialize)]
+pub struct ManagedModuleState {
+    pub values: BTreeMap<String, ManagedValue>,
+}
+
+impl ManagedModuleState {
+    pub fn load_from_file<P: AsRef<Path>>(path: P) -> Result<Self> {
+        let path = path.as_ref();
+        if !path.exists() {
+            return Ok(Self::default());
+        }
+
+        let source = std::fs::read_to_string(path)
+            .with_context(|| format!("could not read {}", path.display()))?;
+        for line in source.lines().take(16) {
+            if let Some(json) = line.strip_prefix(MANAGED_STATE_PREFIX) {
+                return serde_json::from_str(json)
+                    .context("could not parse embedded Nix Software Center module state");
+            }
+        }
+
+        // A hand-created or older managed file is safe to treat as having no
+        // editable state. We never attempt to reverse-parse arbitrary Nix.
+        Ok(Self::default())
+    }
+
+    pub fn render_nix(&self) -> Result<String> {
+        let state_json = serde_json::to_string(self)
+            .context("could not serialize managed module state")?;
+        let mut out = String::new();
+        out.push_str("# Generated by Nix Software Center. Do not edit by hand.\n");
+        out.push_str(MANAGED_STATE_PREFIX);
+        out.push_str(&state_json);
+        out.push('\n');
+        out.push_str("{ pkgs, lib, ... }:\nlib.mkMerge [\n");
+
+        // Each assignment is its own module fragment. `lib.mkMerge` avoids
+        // syntactic parent/child collisions such as setting both `a.b` and
+        // `a.b.c` while still letting the NixOS module system resolve types.
+        for (path, value) in &self.values {
+            out.push_str("  { ");
+            out.push_str(&render_attr_path(path));
+            out.push_str(" = ");
+            out.push_str(&render_managed_value(value)?);
+            out.push_str("; }\n");
+        }
+
+        out.push_str("]\n");
+        Ok(out)
+    }
+}
+
+/// Convert a static NixOS option path into a Nix attribute path. Segments that
+/// are not plain identifiers are quoted instead of being emitted as raw syntax.
+pub fn render_attr_path(path: &str) -> String {
+    path.split('.')
+        .map(|segment| {
+            if is_nix_identifier(segment) {
+                segment.to_string()
+            } else {
+                nix_string(segment)
+            }
+        })
+        .collect::<Vec<_>>()
+        .join(".")
+}
+
+pub fn managed_config_path(system_config: Option<&str>) -> Option<std::path::PathBuf> {
+    let config = system_config?;
+    let parent = Path::new(config).parent()?;
+    Some(parent.join("nix-software-center-modules.nix"))
+}
+
+pub fn managed_value_from_text(spec: &ModuleOptionSpec, text: &str) -> Result<ManagedValue> {
+    let trimmed = text.trim();
+    if spec.nullable && trimmed == "null" {
+        return Ok(ManagedValue::Null);
+    }
+    match spec.renderer {
+        RendererKind::Integer => trimmed
+            .parse::<i64>()
+            .map(ManagedValue::Integer)
+            .context("expected an integer"),
+        RendererKind::Float => {
+            let value = trimmed.parse::<f64>().context("expected a number")?;
+            if !value.is_finite() {
+                anyhow::bail!("number must be finite");
+            }
+            Ok(ManagedValue::Float(value))
+        }
+        RendererKind::Text => Ok(ManagedValue::String(text.to_string())),
+        RendererKind::Choice => {
+            if !spec.choices.is_empty() && !spec.choices.iter().any(|x| x == text) {
+                anyhow::bail!("value is not one of the documented choices");
+            }
+            Ok(ManagedValue::Choice(text.to_string()))
+        }
+        RendererKind::Path => {
+            if trimmed.is_empty() {
+                anyhow::bail!("path cannot be empty");
+            }
+            Ok(ManagedValue::Path(text.to_string()))
+        }
+        RendererKind::Package => {
+            let attribute = trimmed.strip_prefix("pkgs.").unwrap_or(trimmed);
+            if !is_package_attr_path(attribute) {
+                anyhow::bail!("package must be a nixpkgs attribute path such as firefox or python3Packages.requests");
+            }
+            Ok(ManagedValue::Package(attribute.to_string()))
+        }
+        RendererKind::List => {
+            let value: Value = serde_json::from_str(text)
+                .context("list editor expects JSON, for example [\"one\", \"two\"]")?;
+            if !value.is_array() {
+                anyhow::bail!("list editor expects a JSON array");
+            }
+            Ok(ManagedValue::Json(value))
+        }
+        RendererKind::KeyValue => {
+            let value: Value = serde_json::from_str(text)
+                .context("attribute editor expects JSON, for example {\"key\": \"value\"}")?;
+            if !value.is_object() {
+                anyhow::bail!("attribute editor expects a JSON object");
+            }
+            Ok(ManagedValue::Json(value))
+        }
+        RendererKind::Toggle => anyhow::bail!("boolean values are edited with a switch"),
+        RendererKind::Advanced => anyhow::bail!("advanced options are read-only in the generated editor"),
+    }
+}
+
+pub fn managed_value_editor_text(value: &ManagedValue) -> String {
+    match value {
+        ManagedValue::Null => "null".into(),
+        ManagedValue::Bool(value) => value.to_string(),
+        ManagedValue::Integer(value) => value.to_string(),
+        ManagedValue::Float(value) => value.to_string(),
+        ManagedValue::String(value)
+        | ManagedValue::Choice(value)
+        | ManagedValue::Path(value)
+        | ManagedValue::Package(value) => value.clone(),
+        ManagedValue::Json(value) => serde_json::to_string_pretty(value).unwrap_or_default(),
+    }
+}
+
+fn render_managed_value(value: &ManagedValue) -> Result<String> {
+    match value {
+        ManagedValue::Null => Ok("null".into()),
+        ManagedValue::Bool(value) => Ok(value.to_string()),
+        ManagedValue::Integer(value) => Ok(value.to_string()),
+        ManagedValue::Float(value) => {
+            if value.is_finite() {
+                Ok(value.to_string())
+            } else {
+                anyhow::bail!("cannot render a non-finite number")
+            }
+        }
+        ManagedValue::String(value) | ManagedValue::Choice(value) => Ok(nix_string(value)),
+        ManagedValue::Path(value) => Ok(format!("builtins.toPath {}", nix_string(value))),
+        ManagedValue::Package(value) => {
+            if !is_package_attr_path(value) {
+                anyhow::bail!("invalid package attribute path: {}", value);
+            }
+            Ok(format!("pkgs.{}", render_attr_path(value)))
+        }
+        ManagedValue::Json(value) => render_json_as_nix(value),
+    }
+}
+
+fn render_json_as_nix(value: &Value) -> Result<String> {
+    match value {
+        Value::Null => Ok("null".into()),
+        Value::Bool(value) => Ok(value.to_string()),
+        Value::Number(value) => Ok(value.to_string()),
+        Value::String(value) => Ok(nix_string(value)),
+        Value::Array(values) => {
+            let rendered = values
+                .iter()
+                .map(render_json_as_nix)
+                .collect::<Result<Vec<_>>>()?;
+            Ok(format!("[ {} ]", rendered.join(" ")))
+        }
+        Value::Object(values) => {
+            let mut rendered = Vec::with_capacity(values.len());
+            for (key, value) in values {
+                rendered.push(format!(
+                    "{} = {};",
+                    if is_nix_identifier(key) {
+                        key.to_string()
+                    } else {
+                        nix_string(key)
+                    },
+                    render_json_as_nix(value)?
+                ));
+            }
+            Ok(format!("{{ {} }}", rendered.join(" ")))
+        }
+    }
+}
+
+fn nix_string(value: &str) -> String {
+    let mut out = String::with_capacity(value.len() + 2);
+    out.push('"');
+    let mut chars = value.chars().peekable();
+    while let Some(ch) = chars.next() {
+        match ch {
+            '\\' => out.push_str("\\\\"),
+            '"' => out.push_str("\\\""),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            '$' if chars.peek() == Some(&'{') => out.push_str("\\$"),
+            _ => out.push(ch),
+        }
+    }
+    out.push('"');
+    out
+}
+
+fn is_nix_identifier(value: &str) -> bool {
+    let mut chars = value.chars();
+    let Some(first) = chars.next() else {
+        return false;
+    };
+    if !(first.is_ascii_alphabetic() || first == '_') {
+        return false;
+    }
+    chars.all(|ch| ch.is_ascii_alphanumeric() || matches!(ch, '_' | '-' | '\''))
+}
+
+fn is_package_attr_path(value: &str) -> bool {
+    !value.is_empty()
+        && !value.contains('<')
+        && !value.contains('>')
+        && value.split('.').all(is_nix_identifier)
+}
+
+#[cfg(test)]
+mod managed_tests {
+    use super::*;
+
+    #[test]
+    fn renders_managed_state_deterministically() {
+        let state = ManagedModuleState {
+            values: BTreeMap::from([
+                (
+                    "services.openssh.enable".into(),
+                    ManagedValue::Bool(true),
+                ),
+                (
+                    "services.openssh.ports".into(),
+                    ManagedValue::Json(Value::Array(vec![Value::from(22)])),
+                ),
+            ]),
+        };
+
+        let rendered = state.render_nix().unwrap();
+        assert!(rendered.contains("services.openssh.enable = true;"));
+        assert!(rendered.contains("services.openssh.ports = [ 22 ];"));
+        assert!(rendered.contains(MANAGED_STATE_PREFIX));
+        assert_eq!(rendered, state.render_nix().unwrap());
+    }
+
+    #[test]
+    fn escapes_interpolation_in_nix_strings() {
+        let state = ManagedModuleState {
+            values: BTreeMap::from([(
+                "services.test.message".into(),
+                ManagedValue::String("value ${notInterpolation}".into()),
+            )]),
+        };
+        let rendered = state.render_nix().unwrap();
+        assert!(rendered.contains(r#"\${notInterpolation}"#));
+    }
+
+    #[test]
+    fn package_attribute_paths_are_validated() {
+        let option = ModuleOptionSpec {
+            path: "services.test.package".into(),
+            relative_path: "package".into(),
+            type_name: "package".into(),
+            renderer: RendererKind::Package,
+            nullable: false,
+            choices: vec![],
+            dynamic_path: false,
+            read_only: false,
+            description: None,
+            default: None,
+            example: None,
+            declarations: vec![],
+        };
+
+        assert!(managed_value_from_text(&option, "python3Packages.requests").is_ok());
+        assert!(managed_value_from_text(&option, "import ./evil.nix").is_err());
+    }
+
+    #[test]
+    fn list_editor_requires_json_array() {
+        let mut option = ModuleOptionSpec {
+            path: "services.test.values".into(),
+            relative_path: "values".into(),
+            type_name: "list of string".into(),
+            renderer: RendererKind::List,
+            nullable: false,
+            choices: vec![],
+            dynamic_path: false,
+            read_only: false,
+            description: None,
+            default: None,
+            example: None,
+            declarations: vec![],
+        };
+
+        assert!(managed_value_from_text(&option, r#"["one", "two"]"#).is_ok());
+        assert!(managed_value_from_text(&option, r#"{"one": 1}"#).is_err());
+
+        option.renderer = RendererKind::KeyValue;
+        assert!(managed_value_from_text(&option, r#"{"one": 1}"#).is_ok());
+    }
+}
