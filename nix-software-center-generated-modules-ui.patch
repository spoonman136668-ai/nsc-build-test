+    fn init(
+        params: Self::Init,
+        _root: &Self::Root,
+        sender: ComponentSender<Self>,
+    ) -> ComponentParts<Self> {
+        let module_list = gtk::ListBox::new();
+        let detail_box = gtk::Box::new(gtk::Orientation::Vertical, 10);
+        let integration_ready = managed_config_path(params.config.systemconfig.as_deref())
+            .map(|path| path.exists())
+            .unwrap_or(false);
+
+        let model = ModulePageModel {
+            catalog: None,
+            state: ManagedModuleState::default(),
+            drafts: BTreeMap::new(),
+            removed: BTreeSet::new(),
+            module_list,
+            detail_box,
+            config: params.config,
+            query: String::new(),
+            selected: None,
+            loading: false,
+            busy: false,
+            dirty: false,
+            valid: true,
+            integration_ready,
+            status: "Open the Modules page to load NixOS option metadata.".into(),
+            preview: "# No module edits yet.\n".into(),
+            tracker: 0,
+        };
+
+        let module_list = &model.module_list;
+        let detail_box = &model.detail_box;
+        let widgets = view_output!();
+
+        model.render_placeholder("Select a generated NixOS module to inspect its options.");
+
+        ComponentParts { model, widgets }
+    }
+
+    fn update(
+        &mut self,
+        msg: Self::Input,
+        sender: ComponentSender<Self>,
+        _root: &Self::Root,
+    ) {
+        self.reset();
+        match msg {
+            ModulePageMsg::Load => {
+                if self.loading || self.catalog.is_some() {
+                    return;
+                }
+                self.set_loading(true);
+                self.set_status("Loading current NixOS module metadata...".into());
+                self.render_placeholder("Loading NixOS options and generating the module catalog...");
+
+                let managed_path = managed_config_path(self.config.systemconfig.as_deref());
+                sender.command(move |out, shutdown| {
+                    shutdown
+                        .register(async move {
+                            let result = tokio::task::spawn_blocking(move || {
+                                let catalog = load_current_nixos_catalog()
+                                    .map_err(|error| error.to_string())?;
+                                let state = match managed_path.as_ref() {
+                                    Some(path) => ManagedModuleState::load_from_file(path)
+                                        .map_err(|error| error.to_string())?,
+                                    None => ManagedModuleState::default(),
+                                };
+                                let integration_ready = managed_path
+                                    .as_ref()
+                                    .map(|path| path.exists())
+                                    .unwrap_or(false);
+                                Ok(LoadedCatalog {
+                                    catalog,
+                                    state,
+                                    managed_path,
+                                    integration_ready,
+                                })
+                            })
+                            .await
+                            .map_err(|error| error.to_string())
+                            .and_then(|result| result);
+                            let _ = out.send(ModulePageAsyncMsg::Loaded(result));
+                        })
+                        .drop_on_shutdown()
+                });
+            }
+            ModulePageMsg::Refresh => {
+                self.catalog = None;
+                self.selected = None;
+                self.drafts.clear();
+                self.removed.clear();
+                self.set_dirty(false);
+                self.module_list_remove_all();
+                sender.input(ModulePageMsg::Load);
+            }
+            ModulePageMsg::UpdateConfig(config) => {
+                self.config = config;
+                let managed_path = managed_config_path(self.config.systemconfig.as_deref());
+                self.set_integration_ready(
+                    managed_path
+                        .as_ref()
+                        .map(|path| path.exists())
+                        .unwrap_or(false),
+                );
+                if let Some(path) = managed_path {
+                    match ManagedModuleState::load_from_file(path) {
+                        Ok(state) => self.state = state,
+                        Err(error) => warn!("Could not reload managed module state: {}", error),
+                    }
+                }
+                self.refresh_preview();
+                self.render_selected(&sender);
+            }
+            ModulePageMsg::Search(query) => {
+                self.set_query(query);
+                self.render_module_list(&sender);
+            }
+            ModulePageMsg::Select(id) => {
+                self.set_selected(Some(id));
+                self.render_selected(&sender);
+            }
+            ModulePageMsg::SetBool(path, value) => {
+                self.removed.remove(&path);
+                self.drafts.insert(path, DraftValue::Bool(value));
+                self.refresh_dirty();
+                self.refresh_preview();
+            }
+            ModulePageMsg::SetText(path, value) => {
+                self.removed.remove(&path);
+                self.drafts.insert(path, DraftValue::Text(value));
+                self.refresh_dirty();
+                self.refresh_preview();
+            }
+            ModulePageMsg::Reset(path) => {
+                self.drafts.remove(&path);
+                if self.state.values.contains_key(&path) {
+                    self.removed.insert(path);
+                } else {
+                    self.removed.remove(&path);
+                }
+                self.refresh_dirty();
+                self.refresh_preview();
+                self.render_selected(&sender);
+            }
+            ModulePageMsg::ResetModule => {
+                let Some(root) = self.selected.clone() else {
+                    return;
+                };
+                let paths = self
+                    .catalog
+                    .as_ref()
+                    .and_then(|catalog| catalog.get(&root))
+                    .map(|module| module.options.iter().map(|option| option.path.clone()).collect::<Vec<_>>())
+                    .unwrap_or_default();
+                for path in paths {
+                    self.drafts.remove(&path);
+                    if self.state.values.contains_key(&path) {
+                        self.removed.insert(path);
+                    }
+                }
+                self.refresh_dirty();
+                self.refresh_preview();
+                self.render_selected(&sender);
+            }
+            ModulePageMsg::Apply => {
+                if self.busy || !self.dirty || !self.integration_ready {
+                    return;
+                }
+                let next_state = match self.merged_state() {
+                    Ok(state) => state,
+                    Err(error) => {
+                        self.set_valid(false);
+                        self.set_status(format!("Cannot apply: {}", error));
+                        return;
+                    }
+                };
+                let source = match next_state.render_nix() {
+                    Ok(source) => source,
+                    Err(error) => {
+                        self.set_valid(false);
+                        self.set_status(format!("Cannot generate Nix: {}", error));
+                        return;
+                    }
+                };
+                let Some(path) = managed_config_path(self.config.systemconfig.as_deref()) else {
+                    self.set_status("No NixOS configuration file is configured.".into());
+                    return;
+                };
+                let config = self.config.clone();
+                self.set_busy(true);
+                self.set_status("Testing the generated module configuration before switching...".into());
+                REBUILD_BROKER.send(super::rebuild::RebuildMsg::Show);
+
+                sender.command(move |out, shutdown| {
+                    shutdown
+                        .register(async move {
+                            let result = apply_managed_configuration(source, path, config)
+                                .await
+                                .map(|_| next_state)
+                                .map_err(|error| error.to_string());
+                            let _ = out.send(ModulePageAsyncMsg::Applied(result));
+                        })
+                        .drop_on_shutdown()
+                });
+            }
+        }
+    }
+
+    fn update_cmd(
+        &mut self,
+        msg: Self::CommandOutput,
+        sender: ComponentSender<Self>,
+        _root: &Self::Root,
+    ) {
+        self.reset();
+        match msg {
+            ModulePageAsyncMsg::Loaded(result) => {
+                self.set_loading(false);
+                match result {
+                    Ok(loaded) => {
+                        let module_count = loaded.catalog.stats.module_count;
+                        let automatic = loaded.catalog.stats.automatic_options;
+                        let advanced = loaded.catalog.stats.advanced_options;
+                        self.catalog = Some(loaded.catalog);
+                        self.state = loaded.state;
+                        self.set_integration_ready(loaded.integration_ready);
+                        self.drafts.clear();
+                        self.removed.clear();
+                        self.set_dirty(false);
+                        self.set_valid(true);
+                        self.refresh_preview();
+                        self.set_status(if loaded.integration_ready {
+                            format!(
+                                "{} generated modules loaded • {} automatic options • {} advanced fallbacks",
+                                module_count, automatic, advanced
+                            )
+                        } else if let Some(path) = loaded.managed_path {
+                            format!(
+                                "{} modules loaded. Apply is disabled until {} is installed/imported.",
+                                module_count,
+                                path.display()
+                            )
+                        } else {
+                            format!(
+                                "{} modules loaded. Configure a NixOS configuration file to enable Apply.",
+                                module_count
+                            )
+                        });
+                        self.render_module_list(&sender);
+                    }
+                    Err(error) => {
+                        self.set_status(format!("Module metadata load failed: {}", error));
+                        self.render_placeholder("Could not load NixOS module metadata. Use Refresh to retry.");
+                    }
+                }
+            }
+            ModulePageAsyncMsg::Applied(result) => {
+                self.set_busy(false);
+                match result {
+                    Ok(state) => {
+                        self.state = state;
+                        self.drafts.clear();
+                        self.removed.clear();
+                        self.set_dirty(false);
+                        self.set_valid(true);
+                        self.refresh_preview();
+                        self.set_status("Configuration tested and switched successfully.".into());
+                        REBUILD_BROKER.send(super::rebuild::RebuildMsg::FinishSuccess);
+                        self.render_selected(&sender);
+                    }
+                    Err(error) => {
+                        self.set_status(format!("Apply failed and the managed file was restored: {}", error));
+                        REBUILD_BROKER.send(super::rebuild::RebuildMsg::FinishError(Some(error)));
+                    }
+                }
+            }
+        }
+    }
+}
+
+impl ModulePageModel {
+    fn module_list_remove_all(&self) {
+        while let Some(child) = self.module_list.first_child() {
+            self.module_list.remove(&child);
+        }
+    }
+
+    fn detail_remove_all(&self) {
+        while let Some(child) = self.detail_box.first_child() {
+            self.detail_box.remove(&child);
+        }
+    }
+
+    fn render_placeholder(&self, text: &str) {
+        self.detail_remove_all();
+        let label = gtk::Label::new(Some(text));
+        label.set_wrap(true);
+        label.set_halign(gtk::Align::Start);
+        label.add_css_class("dim-label");
+        self.detail_box.append(&label);
+    }
+
+    fn render_module_list(&mut self, sender: &ComponentSender<Self>) {
+        self.module_list_remove_all();
+        let Some(catalog) = self.catalog.as_ref() else {
+            return;
+        };
+        let query = self.query.trim().to_lowercase();
+        let mut visible = Vec::new();
+
+        for (id, module) in &catalog.modules {
+            if !query.is_empty()
+                && !id.to_lowercase().contains(&query)
+                && !module.title.to_lowercase().contains(&query)
+            {
+                continue;
+            }
+            visible.push(id.clone());
+            if visible.len() >= MAX_VISIBLE_MODULES {
+                break;
+            }
+        }
+
+        for id in &visible {
+            let Some(module) = catalog.get(id) else {
+                continue;
+            };
+            let row = adw::ActionRow::new();
+            row.set_use_markup(false);
+            row.set_title(&module.title);
+            row.set_subtitle(&format!(
+                "{} automatic • {} advanced",
+                module.automatic_options, module.advanced_options
+            ));
+            row.set_activatable(true);
+            let row_id = id.clone();
+            let sender = sender.clone();
+            row.connect_activated(move |_| {
+                sender.input(ModulePageMsg::Select(row_id.clone()));
+            });
+            self.module_list.append(&row);
+        }
+
+        if visible.is_empty() {
+            let row = adw::ActionRow::new();
+            row.set_use_markup(false);
+            row.set_title("No generated modules match this search");
+            self.module_list.append(&row);
+            return;
+        }
+
+        let selected_visible = self
+            .selected
+            .as_ref()
+            .map(|selected| visible.iter().any(|id| id == selected))
+            .unwrap_or(false);
+        if !selected_visible {
+            sender.input(ModulePageMsg::Select(visible[0].clone()));
+        }
+    }
+
+    fn render_selected(&mut self, sender: &ComponentSender<Self>) {
+        self.detail_remove_all();
+        let Some(id) = self.selected.clone() else {
+            self.render_placeholder("Select a module from the left.");
+            return;
+        };
+        let Some(catalog) = self.catalog.as_ref() else {
+            self.render_placeholder("Module metadata has not been loaded.");
+            return;
+        };
+        let Some(module) = catalog.get(&id) else {
+            self.render_placeholder("The selected module is no longer present.");
+            return;
+        };
+
+        let title = gtk::Label::new(Some(&module.title));
+        title.set_halign(gtk::Align::Start);
+        title.set_selectable(true);
+        title.add_css_class("title-2");
+        self.detail_box.append(&title);
+
+        let summary = gtk::Label::new(Some(&format!(
+            "{} options • {} automatically editable • {} advanced fallbacks • {} read-only",
+            module.options.len(),
+            module.automatic_options,
+            module.advanced_options,
+            module.read_only_options
+        )));
+        summary.set_halign(gtk::Align::Start);
+        summary.add_css_class("dim-label");
+        self.detail_box.append(&summary);
+
+        let list = gtk::ListBox::new();
+        list.add_css_class("boxed-list");
+        list.set_selection_mode(gtk::SelectionMode::None);
+
+        let mut options = module.options.iter().collect::<Vec<_>>();
+        options.sort_by_key(|option| (option.relative_path != "enable", option.relative_path.clone()));
+        let total_options = options.len();
+        for option in options.into_iter().take(MAX_VISIBLE_OPTIONS) {
+            list.append(&self.option_row(option, sender));
+        }
+        self.detail_box.append(&list);
+
+        if total_options > MAX_VISIBLE_OPTIONS {
+            let note = gtk::Label::new(Some(&format!(
+                "Showing the first {} of {} options. Narrower generated child modules are listed separately.",
+                MAX_VISIBLE_OPTIONS, total_options
+            )));
+            note.set_wrap(true);
+            note.set_halign(gtk::Align::Start);
+            note.add_css_class("dim-label");
+            self.detail_box.append(&note);
+        }
+    }
+
+    fn option_row(&self, option: &ModuleOptionSpec, sender: &ComponentSender<Self>) -> adw::ActionRow {
+        let row = adw::ActionRow::new();
+        row.set_use_markup(false);
+        row.set_title(if option.relative_path.is_empty() {
+            &option.path
+        } else {
+            &option.relative_path
+        });
+        let description = option
+            .description
+            .as_deref()
+            .unwrap_or("")
+            .replace('\n', " ");
+        row.set_subtitle(&format!(
+            "{}{}{}",
+            option.type_name,
+            if description.is_empty() { "" } else { " — " },
+            description
+        ));
+
+        if option.read_only {
+            let badge = gtk::Label::new(Some("Read-only"));
+            badge.add_css_class("dim-label");
+            row.add_suffix(&badge);
+            return row;
+        }
+        if option.renderer == RendererKind::Advanced {
+            let badge = gtk::Label::new(Some("Advanced"));
+            badge.add_css_class("dim-label");
+            row.add_suffix(&badge);
+            return row;
+        }
+
+        let has_override = self.has_effective_override(&option.path);
+        if has_override {
+            let reset = gtk::Button::new();
+            reset.set_icon_name("edit-undo-symbolic");
+            reset.set_tooltip_text(Some("Return this option to the NixOS default"));
+            reset.set_valign(gtk::Align::Center);
+            let path = option.path.clone();
+            let sender = sender.clone();
+            reset.connect_clicked(move |_| {
+                sender.input(ModulePageMsg::Reset(path.clone()));
+            });
+            row.add_suffix(&reset);
+        }
+
+        match option.renderer {
+            RendererKind::Toggle => {
+                let switch = gtk::Switch::new();
+                switch.set_valign(gtk::Align::Center);
+                switch.set_active(self.effective_bool(option));
+                let path = option.path.clone();
+                let sender = sender.clone();
+                switch.connect_state_set(move |_, value| {
+                    sender.input(ModulePageMsg::SetBool(path.clone(), value));
+                    gtk::Inhibit(false)
+                });
+                row.add_suffix(&switch);
+            }
+            RendererKind::Choice if !option.choices.is_empty() => {
+                let combo = gtk::ComboBoxText::new();
+                combo.set_valign(gtk::Align::Center);
+                let current = self.effective_text(option);
+                let mut active = None;
+                let mut offset = 0usize;
+                if option.nullable {
+                    combo.append_text("null");
+                    if current == "null" {
+                        active = Some(0);
+                    }
+                    offset = 1;
+                }
+                for (index, choice) in option.choices.iter().enumerate() {
+                    combo.append_text(choice);
+                    if current == *choice {
+                        active = Some((index + offset) as u32);
+                    }
+                }
+                combo.set_active(active);
+                let path = option.path.clone();
+                let sender = sender.clone();
+                combo.connect_changed(move |combo| {
+                    if let Some(text) = combo.active_text() {
+                        sender.input(ModulePageMsg::SetText(path.clone(), text.to_string()));
+                    }
+                });
+                row.add_suffix(&combo);
+            }
+            _ => {
+                let entry = gtk::Entry::new();
+                entry.set_valign(gtk::Align::Center);
+                entry.set_width_chars(28);
+                entry.set_hexpand(false);
+                entry.set_text(&self.effective_text(option));
+                entry.set_placeholder_text(Some(match option.renderer {
+                    RendererKind::List => "JSON array, e.g. [\"one\", \"two\"]",
+                    RendererKind::KeyValue => "JSON object, e.g. {\"key\": \"value\"}",
+                    RendererKind::Package => "nixpkgs attribute, e.g. firefox",
+                    RendererKind::Path => "/path/to/value",
+                    RendererKind::Integer => "integer",
+                    RendererKind::Float => "number",
+                    _ => "value",
+                }));
+                let path = option.path.clone();
+                let sender = sender.clone();
+                entry.connect_changed(move |entry| {
+                    sender.input(ModulePageMsg::SetText(path.clone(), entry.text().to_string()));
+                });
+                row.add_suffix(&entry);
+            }
+        }
+
+        row
+    }
+
+    fn effective_bool(&self, option: &ModuleOptionSpec) -> bool {
+        if let Some(DraftValue::Bool(value)) = self.drafts.get(&option.path) {
+            return *value;
+        }
+        if !self.removed.contains(&option.path) {
+            if let Some(ManagedValue::Bool(value)) = self.state.values.get(&option.path) {
+                return *value;
+            }
+        }
+        option
+            .default
+            .as_ref()
+            .and_then(|value| value.as_bool())
+            .unwrap_or(false)
+    }
+
+    fn effective_text(&self, option: &ModuleOptionSpec) -> String {
+        if let Some(DraftValue::Text(value)) = self.drafts.get(&option.path) {
+            return value.clone();
+        }
+        if !self.removed.contains(&option.path) {
+            if let Some(value) = self.state.values.get(&option.path) {
+                return managed_value_editor_text(value);
+            }
+        }
+        option_default_editor_text(option)
+    }
+
+    fn has_effective_override(&self, path: &str) -> bool {
+        self.drafts.contains_key(path)
+            || (self.state.values.contains_key(path) && !self.removed.contains(path))
+    }
+
+    fn find_option(&self, path: &str) -> Option<&ModuleOptionSpec> {
+        self.catalog.as_ref()?.modules.values().find_map(|module| {
+            module.options.iter().find(|option| option.path == path)
+        })
+    }
+
+    fn merged_state(&self) -> Result<ManagedModuleState> {
+        let mut state = self.state.clone();
+        for path in &self.removed {
+            state.values.remove(path);
+        }
+        for (path, draft) in &self.drafts {
+            let option = self
+                .find_option(path)
+                .with_context(|| format!("option metadata disappeared for {}", path))?;
+            let value = match draft {
+                DraftValue::Bool(value) => ManagedValue::Bool(*value),
+                DraftValue::Text(value) => managed_value_from_text(option, value)
+                    .with_context(|| format!("{}: invalid value", path))?,
+            };
+            state.values.insert(path.clone(), value);
+        }
+        Ok(state)
+    }
+
+    fn refresh_dirty(&mut self) {
+        self.set_dirty(!self.drafts.is_empty() || !self.removed.is_empty());
+        if self.dirty {
+            self.set_status(if self.integration_ready {
+                "Unsaved module changes. Apply will run nixos-rebuild test before switch.".into()
+            } else {
+                "Changes are staged, but the managed NixOS integration file is not installed.".into()
+            });
+        }
+    }
+
+    fn refresh_preview(&mut self) {
+        match self
+            .merged_state()
+            .and_then(|state| state.render_nix())
+        {
+            Ok(preview) => {
+                self.set_valid(true);
+                self.set_preview(preview);
+            }
+            Err(error) => {
+                self.set_valid(false);
+                self.set_preview(format!("# Invalid staged value\n# {}\n", error));
+                self.set_status(format!("Fix the invalid value before applying: {}", error));
+            }
+        }
+    }
+}
+
+fn option_default_editor_text(option: &ModuleOptionSpec) -> String {
+    let Some(default) = option.default.as_ref() else {
+        return String::new();
+    };
+    match option.renderer {
+        RendererKind::Integer => default.as_i64().map(|value| value.to_string()).unwrap_or_default(),
+        RendererKind::Float => default.as_f64().map(|value| value.to_string()).unwrap_or_default(),
+        RendererKind::Text | RendererKind::Choice | RendererKind::Path | RendererKind::Package => {
+            default.as_str().unwrap_or_default().to_string()
+        }
+        RendererKind::List if default.is_array() => serde_json::to_string_pretty(default).unwrap_or_default(),
+        RendererKind::KeyValue if default.is_object() => serde_json::to_string_pretty(default).unwrap_or_default(),
+        _ => String::new(),
+    }
+}
+
+async fn apply_managed_configuration(
+    source: String,
+    path: PathBuf,
+    config: NixDataConfig,
+) -> Result<()> {
+    let exe = helper_path();
+    let mut command = tokio::process::Command::new("pkexec");
+    command
+        .arg(&exe)
+        .arg("managed-config")
+        .arg("--generations")
+        .arg(config.generations.unwrap_or(0).to_string())
+        .arg("--output")
+        .arg(&path)
+        .arg("--")
+        .arg("--impure")
+        .stdin(Stdio::piped())
+        .stderr(Stdio::piped());
+
+    if let Some(flake) = config.flake {
+        let flake = if let Some(flakearg) = config.flakearg {
+            format!("{}#{}", flake, flakearg)
+        } else {
+            flake
+        };
+        command.arg("--flake");
+        for arg in flake.split(' ') {
+            if !arg.is_empty() {
+                command.arg(arg);
+            }
+        }
+    }
+
+    let mut child = command.spawn().context("could not launch privileged rebuild helper")?;
+    child
+        .stdin
+        .take()
+        .context("could not open helper stdin")?
+        .write_all(source.as_bytes())
+        .await
+        .context("could not send generated Nix to helper")?;
+
+    let stderr = child.stderr.take().context("could not capture rebuild output")?;
+    let mut lines = tokio::io::BufReader::new(stderr).lines();
+    let mut captured = Vec::new();
+    while let Some(line) = lines.next_line().await? {
+        REBUILD_BROKER.send(super::rebuild::RebuildMsg::UpdateText(line.clone()));
+        captured.push(line);
+        if captured.len() > 50 {
+            captured.remove(0);
+        }
+    }
+
+    let status = child.wait().await.context("could not wait for rebuild helper")?;
+    if status.success() {
+        Ok(())
+    } else {
+        let message = if captured.is_empty() {
+            format!("managed rebuild helper exited with {}", status)
+        } else {
+            captured.join("\n")
+        };
+        anyhow::bail!(message)
+    }
+}
+
+fn helper_path() -> String {
+    match std::env::current_exe() {
+        Ok(mut exe) => {
+            exe.pop();
+            exe.pop();
+            exe.push("libexec");
+            exe.push("nsc-helper");
+            let candidate = exe.to_string_lossy().to_string();
+            if Path::new(&candidate).is_file() {
+                candidate
+            } else {
+                "nsc-helper".into()
+            }
+        }
+        Err(_) => "nsc-helper".into(),
+    }
+}
