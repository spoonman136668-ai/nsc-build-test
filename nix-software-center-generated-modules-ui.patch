+fn managed_config(
+    output: &str,
+    arguments: Vec<String>,
+    generations: Option<u32>,
+) -> Result<(), Box<dyn Error>> {
+    let existed = std::path::Path::new(output).exists();
+    let old = fs::read_to_string(output).ok();
+
+    write_file(output)?;
+
+    let mut test_args = vec![String::from("test")];
+    test_args.extend(arguments.clone());
+    if let Err(err) = rebuild(test_args, None) {
+        restore_file(output, existed, old.as_deref())?;
+
+        // `nixos-rebuild test` can activate a temporary generation before a
+        // later activation step fails. Reassert the restored configuration.
+        let mut rollback_args = vec![String::from("switch")];
+        rollback_args.extend(arguments.clone());
+        if let Err(rollback_err) = rebuild(rollback_args, None) {
+            eprintln!("Rollback rebuild also failed: {}", rollback_err);
+        }
+        return Err(err);
+    }
+
+    let mut switch_args = vec![String::from("switch")];
+    switch_args.extend(arguments.clone());
+    if let Err(err) = rebuild(switch_args, generations) {
+        restore_file(output, existed, old.as_deref())?;
+
+        // Best-effort activation of the restored configuration. The original
+        // switch error remains authoritative even if this rollback rebuild fails.
+        let mut rollback_args = vec![String::from("switch")];
+        rollback_args.extend(arguments);
+        if let Err(rollback_err) = rebuild(rollback_args, None) {
+            eprintln!("Rollback rebuild also failed: {}", rollback_err);
+        }
+        return Err(err);
+    }
+
+    Ok(())
+}
+
+fn restore_file(path: &str, existed: bool, old: Option<&str>) -> Result<(), Box<dyn Error>> {
+    if existed {
+        if let Some(old) = old {
+            fs::write(path, old)?;
+        }
+    } else if std::path::Path::new(path).exists() {
+        fs::remove_file(path)?;
+    }
+    Ok(())
+}
+
 fn channel() -> Result<(), Box<dyn Error>> {
     let mut cmd = Command::new("nix-channel").arg("--update").spawn()?;
     let x = cmd.wait()?;
