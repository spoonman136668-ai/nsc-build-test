@@ -0,0 +1,838 @@
+use anyhow::{Context, Result};
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+use std::{
+    collections::{BTreeMap, BTreeSet},
+    fs::File,
+    io::BufReader,
+    path::Path,
+};
+
+/// A single entry from the NixOS `options.json` documentation database.
+///
+/// The upstream schema intentionally carries default/example values as JSON because
+/// they can be ordinary values or tagged literal-expression objects.
+#[derive(Debug, Clone, Deserialize)]
+pub struct NixosOptionDoc {
+    #[serde(default)]
+    pub declarations: Vec<String>,
+    #[serde(default)]
+    pub default: Option<Value>,
+    #[serde(default)]
+    pub description: Option<String>,
+    #[serde(default)]
+    pub example: Option<Value>,
+    #[serde(default)]
+    pub loc: Vec<String>,
+    #[serde(default, rename = "readOnly")]
+    pub read_only: bool,
+    #[serde(default, rename = "type")]
+    pub type_name: Option<String>,
+}
+
+/// UI control that can be produced deterministically from an option type.
+///
+/// `Advanced` is a deliberate fail-closed bucket. Unknown types, submodules,
+/// functions, and dynamic `<name>` paths must not be guessed into an editor.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum RendererKind {
+    Toggle,
+    Choice,
+    Integer,
+    Float,
+    Text,
+    Path,
+    Package,
+    List,
+    KeyValue,
+    Advanced,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ModuleOptionSpec {
+    pub path: String,
+    pub relative_path: String,
+    pub type_name: String,
+    pub renderer: RendererKind,
+    pub nullable: bool,
+    pub choices: Vec<String>,
+    pub dynamic_path: bool,
+    pub read_only: bool,
+    pub description: Option<String>,
+    pub default: Option<Value>,
+    pub example: Option<Value>,
+    pub declarations: Vec<String>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ModuleSpec {
+    /// Stable module identifier. Currently identical to the option root.
+    pub id: String,
+    pub root: String,
+    pub title: String,
+    /// Closest enclosing generated module, if one exists.
+    pub parent_module: Option<String>,
+    pub enable_option: String,
+    pub declarations: Vec<String>,
+    pub options: Vec<ModuleOptionSpec>,
+    pub automatic_options: usize,
+    pub advanced_options: usize,
+    pub read_only_options: usize,
+}
+
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ModuleCatalogStats {
+    pub total_options: usize,
+    pub module_count: usize,
+    pub assigned_options: usize,
+    pub unassigned_options: usize,
+    pub automatic_options: usize,
+    pub advanced_options: usize,
+    pub read_only_options: usize,
+    pub dynamic_options: usize,
+}
+
+/// Deterministically generated module metadata.
+///
+/// A BTreeMap is intentional: lookup is logarithmic for a small module set while
+/// iteration and serialized output remain stable across runs.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ModuleCatalog {
+    pub modules: BTreeMap<String, ModuleSpec>,
+    pub stats: ModuleCatalogStats,
+}
+
+impl ModuleCatalog {
+    pub fn get(&self, id: &str) -> Option<&ModuleSpec> {
+        self.modules.get(id)
+    }
+
+    pub fn write_json<P: AsRef<Path>>(&self, path: P) -> Result<()> {
+        let file = File::create(path.as_ref())
+            .with_context(|| format!("could not create {}", path.as_ref().display()))?;
+        serde_json::to_writer(file, self).context("could not serialize module catalog")?;
+        Ok(())
+    }
+}
+
+/// Fetch/cache the option database through the existing `nix-data` path and compile it.
+///
+/// This is intentionally not called from application startup yet. Module indexing should
+/// remain lazy until the module UI consumes it, avoiding a startup regression for the
+/// existing package-only experience.
+pub fn load_current_nixos_catalog() -> Result<ModuleCatalog> {
+    let path = nix_data::cache::nixos::nixosoptions()
+        .context("could not retrieve current NixOS options database")?;
+    load_catalog(path)
+}
+
+/// Load NixOS option documentation and compile it into a deterministic module catalog.
+pub fn load_catalog<P: AsRef<Path>>(path: P) -> Result<ModuleCatalog> {
+    let file = File::open(path.as_ref())
+        .with_context(|| format!("could not open {}", path.as_ref().display()))?;
+    let reader = BufReader::new(file);
+    let docs: BTreeMap<String, NixosOptionDoc> =
+        serde_json::from_reader(reader).context("could not parse NixOS options.json")?;
+    Ok(compile_catalog(&docs))
+}
+
+/// Compile the NixOS options database into module groups.
+///
+/// Root inference is deliberately narrow:
+/// - the option must end in `.enable`;
+/// - its documented type must be boolean-like;
+/// - the path must not contain a dynamic `<name>` segment.
+///
+/// Options are assigned to the longest matching root. That lets a specific child
+/// module (for example `services.foo.backends.bar`) win over its parent while
+/// preserving deterministic behavior.
+pub fn compile_catalog(docs: &BTreeMap<String, NixosOptionDoc>) -> ModuleCatalog {
+    let roots = discover_module_roots(docs);
+    let mut grouped: BTreeMap<String, Vec<ModuleOptionSpec>> = BTreeMap::new();
+    let mut stats = ModuleCatalogStats {
+        total_options: docs.len(),
+        module_count: roots.len(),
+        ..Default::default()
+    };
+
+    for (path, doc) in docs {
+        let root = longest_matching_root(path, &roots);
+        let Some(root) = root else {
+            stats.unassigned_options += 1;
+            continue;
+        };
+
+        let spec = option_spec(path, root, doc);
+        stats.assigned_options += 1;
+        if spec.dynamic_path {
+            stats.dynamic_options += 1;
+        }
+        if spec.read_only {
+            stats.read_only_options += 1;
+        }
+        if spec.renderer == RendererKind::Advanced {
+            stats.advanced_options += 1;
+        } else if !spec.read_only {
+            stats.automatic_options += 1;
+        }
+        grouped.entry(root.to_string()).or_default().push(spec);
+    }
+
+    let mut modules = BTreeMap::new();
+    for root in &roots {
+        let mut options = grouped.remove(root).unwrap_or_default();
+        options.sort_by(|a, b| a.path.cmp(&b.path));
+
+        let automatic_options = options
+            .iter()
+            .filter(|x| x.renderer != RendererKind::Advanced && !x.read_only)
+            .count();
+        let advanced_options = options
+            .iter()
+            .filter(|x| x.renderer == RendererKind::Advanced)
+            .count();
+        let read_only_options = options.iter().filter(|x| x.read_only).count();
+        let declarations = options
+            .iter()
+            .flat_map(|x| x.declarations.iter().cloned())
+            .collect::<BTreeSet<_>>()
+            .into_iter()
+            .collect::<Vec<_>>();
+        let enable_option = format!("{}.enable", root);
+        let parent_module = parent_module_root(root, &roots).map(str::to_string);
+
+        modules.insert(
+            root.clone(),
+            ModuleSpec {
+                id: root.clone(),
+                root: root.clone(),
+                title: root.clone(),
+                parent_module,
+                enable_option,
+                declarations,
+                options,
+                automatic_options,
+                advanced_options,
+                read_only_options,
+            },
+        );
+    }
+
+    ModuleCatalog { modules, stats }
+}
+
+fn discover_module_roots(docs: &BTreeMap<String, NixosOptionDoc>) -> BTreeSet<String> {
+    docs.iter()
+        .filter_map(|(path, doc)| {
+            let root = path.strip_suffix(".enable")?;
+            if root.is_empty()
+                || contains_dynamic_segment(root)
+                || !is_boolean_type(doc.type_name.as_deref().unwrap_or_default())
+            {
+                return None;
+            }
+            Some(root.to_string())
+        })
+        .collect()
+}
+
+/// Find the most specific module root by probing successively shorter path prefixes.
+/// Typical NixOS option paths are only a few segments deep, so this is O(path depth)
+/// instead of scanning every module root for every option.
+fn longest_matching_root<'a>(path: &str, roots: &'a BTreeSet<String>) -> Option<&'a str> {
+    let mut candidate = path;
+    loop {
+        if let Some(root) = roots.get(candidate) {
+            return Some(root.as_str());
+        }
+        let split = candidate.rfind('.')?;
+        candidate = &candidate[..split];
+    }
+}
+
+fn parent_module_root<'a>(root: &str, roots: &'a BTreeSet<String>) -> Option<&'a str> {
+    let split = root.rfind('.')?;
+    longest_matching_root(&root[..split], roots)
+}
+
+fn option_spec(path: &str, root: &str, doc: &NixosOptionDoc) -> ModuleOptionSpec {
+    let relative_path = path
+        .strip_prefix(root)
+        .and_then(|x| x.strip_prefix('.'))
+        .unwrap_or(path)
+        .to_string();
+    let type_name = doc.type_name.clone().unwrap_or_else(|| "unspecified".into());
+    let dynamic_path = contains_dynamic_segment(path);
+    let (mut renderer, nullable, choices) = classify_type(&type_name);
+    if dynamic_path {
+        renderer = RendererKind::Advanced;
+    }
+
+    ModuleOptionSpec {
+        path: path.to_string(),
+        relative_path,
+        type_name,
+        renderer,
+        nullable,
+        choices,
+        dynamic_path,
+        read_only: doc.read_only,
+        description: doc.description.clone(),
+        default: doc.default.clone(),
+        example: doc.example.clone(),
+        declarations: doc.declarations.clone(),
+    }
+}
+
+pub fn classify_type(type_name: &str) -> (RendererKind, bool, Vec<String>) {
+    let mut ty = type_name.trim().to_lowercase();
+    let mut nullable = false;
+
+    if let Some(inner) = ty.strip_prefix("null or ") {
+        nullable = true;
+        ty = inner.trim().to_string();
+    }
+
+    // Complex module structure is never flattened into a generic editor.
+    if ty.contains("submodule")
+        || ty.contains("function")
+        || ty == "anything"
+        || ty == "raw value"
+        || ty == "unspecified"
+    {
+        return (RendererKind::Advanced, nullable, vec![]);
+    }
+
+    if ty.starts_with("list of ") || ty.starts_with("non-empty (list of ") {
+        // Lists whose elements require Nix expressions (packages/paths) need a
+        // type-aware editor rather than pretending JSON strings are equivalent.
+        if ty.contains("package") || ty.contains(" path") {
+            return (RendererKind::Advanced, nullable, vec![]);
+        }
+        return (RendererKind::List, nullable, vec![]);
+    }
+
+    if ty.starts_with("attribute set of ") || ty.starts_with("lazy attribute set of ") {
+        if ty.contains("package") || ty.contains(" path") {
+            return (RendererKind::Advanced, nullable, vec![]);
+        }
+        return (RendererKind::KeyValue, nullable, vec![]);
+    }
+
+    if ty.starts_with("one of ") || ty.contains(" one of ") {
+        return (RendererKind::Choice, nullable, extract_choices(type_name));
+    }
+
+    if is_boolean_type(&ty) {
+        return (RendererKind::Toggle, nullable, vec![]);
+    }
+
+    if ty.contains("integer") || ty.contains("int between") {
+        return (RendererKind::Integer, nullable, vec![]);
+    }
+
+    if ty.contains("floating point") || ty.contains("float") || ty.contains("number") {
+        return (RendererKind::Float, nullable, vec![]);
+    }
+
+    if ty == "path" || ty.ends_with(" path") || ty.contains("path in the nix store") {
+        return (RendererKind::Path, nullable, vec![]);
+    }
+
+    if ty == "package" || ty.ends_with(" package") {
+        return (RendererKind::Package, nullable, vec![]);
+    }
+
+    if ty == "string"
+        || ty.contains("string")
+        || ty == "lines"
+        || ty == "passwd entry"
+        || ty == "shell package"
+    {
+        return (RendererKind::Text, nullable, vec![]);
+    }
+
+    (RendererKind::Advanced, nullable, vec![])
+}
+
+fn is_boolean_type(type_name: &str) -> bool {
+    matches!(type_name.trim().to_lowercase().as_str(), "boolean" | "bool")
+}
+
+fn contains_dynamic_segment(path: &str) -> bool {
+    path.split('.')
+        .any(|segment| segment.starts_with('<') && segment.ends_with('>'))
+}
+
+/// Extract quoted alternatives from an option type such as
+/// `one of "auto", "yes", "no"`. NixOS type descriptions that cannot be
+/// losslessly interpreted simply return an empty list; the original type string
+/// remains available to the UI.
+fn extract_choices(type_name: &str) -> Vec<String> {
+    let mut out = Vec::new();
+    let mut chars = type_name.chars().peekable();
+
+    while let Some(ch) = chars.next() {
+        if ch != '"' {
+            continue;
+        }
+
+        let mut current = String::new();
+        let mut escaped = false;
+        for next in chars.by_ref() {
+            if escaped {
+                current.push(next);
+                escaped = false;
+            } else if next == '\\' {
+                escaped = true;
+            } else if next == '"' {
+                break;
+            } else {
+                current.push(next);
+            }
+        }
+        if !current.is_empty() && !out.contains(&current) {
+            out.push(current);
+        }
+    }
+
+    out
+}
