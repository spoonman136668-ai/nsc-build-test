new file mode 100644
index 0000000..a45052a
--- /dev/null
+++ b/src/bin/nsc-module-index.rs
@@ -0,0 +1,33 @@
+use nix_software_center::parse::modules::{load_catalog, load_current_nixos_catalog};
+use std::{env, error::Error, time::Instant};
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let mut args = env::args().skip(1);
+    let source = args.next().unwrap_or_else(|| "--system".to_string());
+    let output = args.next();
+
+    let start = Instant::now();
+    let catalog = if source == "--system" {
+        load_current_nixos_catalog()?
+    } else {
+        load_catalog(&source)?
+    };
+    let elapsed = start.elapsed();
+
+    if let Some(path) = output {
+        catalog.write_json(path)?;
+    }
+
+    println!("Nix Software Center module index");
+    println!("modules: {}", catalog.stats.module_count);
+    println!("options total: {}", catalog.stats.total_options);
+    println!("options assigned: {}", catalog.stats.assigned_options);
+    println!("options unassigned: {}", catalog.stats.unassigned_options);
+    println!("automatic editors: {}", catalog.stats.automatic_options);
+    println!("advanced fallback: {}", catalog.stats.advanced_options);
+    println!("read-only: {}", catalog.stats.read_only_options);
+    println!("dynamic paths: {}", catalog.stats.dynamic_options);
+    println!("compile elapsed: {:.3?}", elapsed);
+
+    Ok(())
+}
